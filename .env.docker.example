# =============================================================================
# Mashjid Hisab — Docker Compose Environment Configuration (.env.docker.example)
# Copy this file to .env before running docker compose if you want to override defaults:
# cp .env.docker.example .env
# =============================================================================

# PostgreSQL Container Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=mashjid_hisab
POSTGRES_PORT=5432

# Application Ports & URLs
PORT=5000
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Database Connection URL for backend container
DATABASE_URL=postgresql://postgres:postgres_secure_password@postgres:5432/mashjid_hisab?schema=public

# JWT Secrets (Generate with `openssl rand -hex 32`)
JWT_ACCESS_SECRET=your_32_byte_hex_access_secret_here
JWT_REFRESH_SECRET=your_32_byte_hex_refresh_secret_here
JWT_SECRET=your_32_byte_hex_secret_here

